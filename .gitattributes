# ======================================
# 🦀 MAANG FRAMEWORK — .gitattributes
# Ship only compiled binaries + runtime bundle (dist/) and safe configs.
# ======================================

# Normalize line-endings
* text eol=lf

# Treat common text files as text for better diffs
*.rs text
*.toml text
*.md text
*.html text
*.css text
*.js text
*.json text
*.service text
*.timer text
*.conf text
*.fish text
*.sh text

# --------------------------------------
# Export rules (git archive)
# Mark almost everything as export-ignore…
# --------------------------------------

/apps                export-ignore
/assets              export-ignore
/config              export-ignore
/crates              export-ignore
/deploy              export-ignore
/docs                export-ignore
/editor              export-ignore
/i18n                export-ignore
/legal               export-ignore
/marketing           export-ignore
/migrations          export-ignore
/monitor             export-ignore
/ops                 export-ignore
/scripts             export-ignore
/tests               export-ignore
/tools               export-ignore
/var                 export-ignore
/wasm                export-ignore
/wip                 export-ignore

/.gitignore          export-ignore
/.gitattributes      export-ignore
/.idea               export-ignore
/.vscode             export-ignore
/helix               export-ignore
/Cargo.lock          export-ignore
/Cargo.toml          export-ignore
/rust-toolchain.toml export-ignore
/deny.toml           export-ignore
/justfile            export-ignore
/README*             export-ignore
/LICENSE             export-ignore
/VERSION             export-ignore

# --------------------------------------
# …then selectively ALLOW what tenants need
# (remove export-ignore by *not* marking these paths)
# Ship the compiled runtime bundle (place built files here)
# --------------------------------------

# Keep everything under dist/ in exports (binary + assets + safe configs)
/dist/**               -text

# If you want to also ship example env + systemd/nginx templates, un-ignore:
# (uncomment the lines below to include them in exports)
# !/config/.env.example
# !/deploy/systemd/*.service
# !/deploy/systemd/*.timer
# !/deploy/nginx/*.conf

# Optionally include LICENSE and VERSION in releases:
# !/LICENSE
# !/VERSION

# HOW TO USE (Fish)
# cargo build --release
# mkdir -p dist/lillpepe/bin
# cp target/release/lillpepe dist/lillpepe/bin/
# # add any external default static/templates you want shipped:
# cp -r crates/application/web/static dist/lillpepe/static
# cp -r crates/application/web/templates dist/lillpepe/templates
# cp config/.env.example dist/lillpepe/.env.example
