# ======================================
# 🦀 MAANG Global Configuration Example
# ======================================

# Environment
APP_ENV=development
RUST_LOG=info

# Networking
HOST=127.0.0.1
PORT=8080

# Observability
TRACING_LEVEL=info

# Tenant storage (SurrealDB per tenant)
SURREALDB_URL=ws://127.0.0.1:8000
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root
SURREALDB_NAMESPACE=maang
SURREALDB_DATABASE=lillpepe

# Stripe (payments)
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX

# File storage (optional)
STORAGE_PATH=/var/lib/maang/storage

# Email service (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=changeme

# ======================================
# Notes:
# 1. Copy to .env.development for local use:
#    cp .env.example .env.development
# 2. In production, only environment variables are read.
# ======================================
